managed implementation in class zbp_r_spacc110_product unique;
strict ( 2 );
with draft;

define behavior for ZR_SPACC110_PRODUCT alias Product
persistent table zspacc110_produc
draft table zspacc110_prod_d
late numbering
lock master
total etag LastChangedAt
authorization master ( none )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  validation validateProductName on save
  {
    create;
    field ProductName;
  }

  field ( readonly )
    ProductId,
    LocalCreatedBy,
    LocalCreatedAt,
    LocalLastChangedBy,
    LocalLastChangedAt,
    LastChangedAt;

  field ( mandatory : create )
    ProductName;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare
  {
    validation validateProductName;
  }

  mapping for zspacc110_produc
  {
    ProductId          = product_id;
    ProductName        = product_name;
    ProductDescription = product_description;
    Category           = category;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}