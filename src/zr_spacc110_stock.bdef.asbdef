managed implementation in class zbp_r_spacc110_stock unique;
strict ( 2 );
with draft;

define behavior for ZR_SPACC110_STOCK alias Stock
persistent table zspacc110_stock
draft table zspacc110_stoc_d
lock master
total etag LastChangedAt
authorization master ( none )
etag master LocalLastChangedAt
{
  create (precheck );
  update;
  delete;

  field ( mandatory : create )
    warehouse_id,
    product_id,
    amount;

  field ( readonly : update )
    warehouse_id,
    product_id;

  field ( readonly )
    LocalCreatedBy,
    LocalCreatedAt,
    LocalLastChangedBy,
    LocalLastChangedAt,
    LastChangedAt;

  validation validateUniqueStock on save
  {
    create;
  }

  validation validateStockAmount on save
  {
    create;
    field amount;
  }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare
  {
    validation validateUniqueStock;
    validation validateStockAmount;
  }

  mapping for zspacc110_stock
  {
    warehouse_id       = warehouse_id;
    product_id         = product_id;
    amount             = amount;

    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}